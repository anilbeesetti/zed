+fun Project.selectedAndroidGenerationTasks(): List<Task> {
+    val variant = androidVariants?.selectActiveVariant() ?: return emptyList()
+    val names = (listOfNotNull(variant.name) + variant.nestedComponents.orEmpty().mapNotNull { it.name }).toSet()
+    val generators = setOf("com.android.build.gradle.internal.res.GenerateLibraryRFileTask", "com.android.build.gradle.tasks.GenerateBuildConfig")
+    return tasks.filter { task ->
+        task.hasProperty("variantName") && task.property("variantName") in names &&
+            generateSequence<Class<*>>(task.javaClass) { it.superclass }.any { it.name in generators }
+    }
+}
