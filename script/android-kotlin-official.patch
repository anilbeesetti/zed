+fun Project.selectedAndroidConfigurations(): List<Configuration> {
+    val variant = androidVariants?.selectActiveVariant() ?: return emptyList()
+    return (listOfNotNull(variant.compileConfiguration) +
+        variant.nestedComponents.orEmpty().mapNotNull { it.compileConfiguration }).distinct()
