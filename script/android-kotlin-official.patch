+            ?: throw GradleException("The selected Android module $module does not exist")
     }
+    if (selectedProject != null && selectedName != null) {
+        val selectedVariant = selectedProject.androidVariants.orEmpty().singleOrNull { it.name == selectedName }
+            ?: throw GradleException("Android variant $selectedName does not exist in ${selectedProject.path}")
+        if (project == selectedProject) return selectedVariant
