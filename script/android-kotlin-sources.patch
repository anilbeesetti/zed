+        val duplicateCompilation = java.util.concurrent.CountDownLatch(1)
+        val navigationStarted = java.util.concurrent.CountDownLatch(1)
+        val compilationCount = java.util.concurrent.atomic.AtomicInteger()
+        try {
+            val sourcePath = server.sourcePath
+            sourcePath.indexEnabled = false
+            val uri = java.net.URI("file:///cold-navigation.kt")
+            sourcePath.put(uri, "val answer = 42", null)
+            val declaration = sourcePath.parsedFile(uri).declarations.single()
+            sourcePath.beforeCompileCallback = {
+                if (compilationCount.incrementAndGet() == 1) {
+                    compiling.countDown()
+                    check(releaseCompilation.await(10, java.util.concurrent.TimeUnit.SECONDS))
+                } else duplicateCompilation.countDown()
+            }
+            val diagnostics = workers.submit<org.jetbrains.kotlin.resolve.BindingContext> { sourcePath.compileFiles(listOf(uri)) }
+            org.junit.Assert.assertTrue(compiling.await(10, java.util.concurrent.TimeUnit.SECONDS))
+            val navigation = workers.submit<CompiledFile> {
+                navigationStarted.countDown()
+                sourcePath.latestCompiledVersion(uri)
+            }
+            org.junit.Assert.assertTrue(navigationStarted.await(10, java.util.concurrent.TimeUnit.SECONDS))
+            org.junit.Assert.assertFalse("Navigation started a duplicate compilation", duplicateCompilation.await(200, java.util.concurrent.TimeUnit.MILLISECONDS))
+            releaseCompilation.countDown()
+            val diagnosticsContext = diagnostics.get(10, java.util.concurrent.TimeUnit.SECONDS)
+            val navigationContext = navigation.get(10, java.util.concurrent.TimeUnit.SECONDS).compile
+            org.junit.Assert.assertEquals(1, compilationCount.get())
+            org.junit.Assert.assertNotNull(diagnosticsContext[org.jetbrains.kotlin.resolve.BindingContext.DECLARATION_TO_DESCRIPTOR, declaration])
+            org.junit.Assert.assertSame(
+                diagnosticsContext[org.jetbrains.kotlin.resolve.BindingContext.DECLARATION_TO_DESCRIPTOR, declaration],
+                navigationContext[org.jetbrains.kotlin.resolve.BindingContext.DECLARATION_TO_DESCRIPTOR, declaration])
+        } finally {
+            releaseCompilation.countDown()
+            workers.shutdown()
+            check(workers.awaitTermination(20, java.util.concurrent.TimeUnit.SECONDS))
+            server.close()
+        }
+    }
+}
