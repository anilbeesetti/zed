+            assertTrue(resolver.buildScriptClasspath.all { it.fileName.toString().startsWith("kotlin-stdlib") })
+            assertTrue(!resolver.resolverType.contains("Gradle"))
+        } finally {
+            assertTrue(root.toFile().deleteRecursively())
+        }
+    }
