+internal fun attachedSource(uri: KlsURI, archives: List<String>, sourceFile: String? = null): KlsURI? {
+    val classPath = uri.fileUri.schemeSpecificPart.substringAfter("!/", "")
+        .substringBeforeLast('.').substringBefore('$')
+    if (classPath.isEmpty()) return null
+    val sourcePath = sourceFile?.takeIf { '/' !in it && '\\' !in it }
+        ?.let { classPath.substringBeforeLast('/', "").let { directory -> if (directory.isEmpty()) it else "$directory/$it" } }
+    for (archive in archives) {
+        try {
+            ZipFile(archive).use { zip ->
+                // AndroidX multiplatform sources retain their source-set directory.
+                val entry = listOf("", "androidMain/", "jvmMain/", "commonMain/")
+                    .asSequence().flatMap { prefix -> sequenceOf(sourcePath?.let { "$prefix$it" }, "$prefix$classPath.kt", "$prefix$classPath.java").filterNotNull() }
+                    .mapNotNull(zip::getEntry).firstOrNull() ?: return@use
+                return URI(Paths.get(archive).toUri().toString() + "!" + URI(null, null, "/${entry.name}", null).rawPath)
+                    .toKlsURI()?.withSource(true)
+            }
+        } catch (exception: java.io.IOException) {
+            LOG.warn("Could not read attached source archive {}: {}", archive, exception.message)
+        }
+    }
+    return null
+}
