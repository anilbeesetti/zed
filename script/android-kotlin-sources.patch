+internal fun sourceDeclarationRange(source: KtFile, target: DeclarationDescriptor): Range? {
+    val declarationTarget = if (target is ConstructorDescriptor) target.constructedClass else target
+    val name = declarationTarget.name.asString()
+    val candidates = source.collectDescendantsOfType<KtNamedDeclaration> {
+        it.name == name && it.fqName == declarationTarget.fqNameSafe && when (declarationTarget) {
+            is ClassDescriptor -> it is KtClassOrObject
+            is PropertyDescriptor -> it is KtProperty || (it is KtParameter && it.hasValOrVar())
+            is FunctionDescriptor -> it is KtNamedFunction
+            is TypeAliasDescriptor -> it is KtTypeAlias
+            else -> true
+        }
+    }
+    val callable = target as? CallableDescriptor
+    val declaration = if (candidates.size == 1) candidates.single() else candidates.singleOrNull { candidate ->
+        if (candidate !is KtCallableDeclaration || callable == null) false else {
+            val parameters = candidate.valueParameters
+            parameters.size == callable.valueParameters.size && parameters.zip(callable.valueParameters).all { (parameter, descriptor) ->
+                parameter.name == descriptor.name.asString() &&
+                    parameter.typeReference?.text?.filterNot(Char::isWhitespace) ==
+                    DescriptorRenderer.SHORT_NAMES_IN_TYPES.renderType(descriptor.type).filterNot(Char::isWhitespace)
+            } && candidate.receiverTypeReference?.text?.filterNot(Char::isWhitespace) ==
+                callable.extensionReceiverParameter?.type?.let { DescriptorRenderer.SHORT_NAMES_IN_TYPES.renderType(it).filterNot(Char::isWhitespace) }
+        }
+    }
+    return declaration?.nameIdentifier?.textRange?.let {
+        Range(position(source.text, it.startOffset), position(source.text, it.endOffset))
+    }
+}
