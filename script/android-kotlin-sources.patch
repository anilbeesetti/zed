+package org.javacs.kt.externalsources
+
+import java.net.URI
+import java.nio.file.Files
+import java.util.zip.ZipEntry
+import java.util.zip.ZipOutputStream
+import org.junit.Assert.*
+import org.junit.Test
+
+class AttachedSourcesTest {
+    @Test
+    fun `resolve source sets inner classes and paths with spaces`() {
+        val directory = Files.createTempDirectory("attached sources ")
+        val archive = directory.resolve("library sources.jar")
+        try {
+            ZipOutputStream(Files.newOutputStream(archive)).use { zip ->
+                zip.putNextEntry(ZipEntry("androidMain/androidx/activity/ComponentActivity.kt"))
+                zip.write("package androidx.activity\nclass ComponentActivity".toByteArray())
+                zip.closeEntry()
+            }
+            val uri = URI("file:///compiled.jar!/androidx/activity/ComponentActivity${'$'}Nested.class").toKlsURI()!!
+            val source = attachedSource(uri, listOf(archive.toString()))!!
+            assertTrue(source.source)
+            assertEquals("kt", source.fileExtension)
+            assertTrue(source.readContents().contains("class ComponentActivity"))
+            assertNull(attachedSource(uri, emptyList()))
+            assertNull(attachedSource(URI("file:///compiled.jar!/unknown/Class.class").toKlsURI()!!, listOf(archive.toString())))
+        } finally {
+            Files.deleteIfExists(archive)
+            Files.deleteIfExists(directory)
+        }
+    }
+}
