 /** Searches the workspace for all files that could provide classpath info. */
 private fun workspaceResolvers(workspaceRoot: Path): Sequence<ClassPathResolver> {
+    // An explicit root hook already supplies the project model; rediscovering each
+    // Gradle module delays initialization and can replace the synced variant.
+    val explicit = workspaceRoot.toFile().listFiles()?.firstNotNullOfOrNull {
+        ShellClassPathResolver.maybeCreate(it.toPath())
+    }
+    if (explicit != null) return sequenceOf(explicit)
     val ignored: List<PathMatcher> = ignoredPathPatterns(workspaceRoot, workspaceRoot.resolve(".gitignore"))
