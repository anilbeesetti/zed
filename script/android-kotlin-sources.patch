+        try {
+            ZipFile(archive).use { zip ->
+                // AndroidX multiplatform sources retain their source-set directory.
+                val entry = listOf("", "androidMain/", "jvmMain/", "commonMain/")
+                    .asSequence().flatMap { prefix -> sequenceOf(sourcePath?.let { "$prefix$it" }, "$prefix$classPath.kt", "$prefix$classPath.java").filterNotNull() }
