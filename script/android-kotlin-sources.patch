+internal fun attachedSource(uri: KlsURI, archives: List<String>, sourceFile: String? = null): KlsURI? {
+    val classPath = uri.fileUri.schemeSpecificPart.substringAfter("!/", "")
+        .substringBeforeLast('.').substringBefore('$')
+    if (classPath.isEmpty()) return null
+    val sourcePath = sourceFile?.takeIf { '/' !in it && '\\' !in it }
+        ?.let { classPath.substringBeforeLast('/', "").let { directory -> if (directory.isEmpty()) it else "$directory/$it" } }
