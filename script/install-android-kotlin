#!/usr/bin/env python3
"""Build the pinned community Kotlin server for the macOS Android IDE launcher."""

import hashlib
import os
from pathlib import Path
import platform
import shutil
import subprocess
import tarfile
import tempfile
import urllib.request

REVISION = "6d9e61b79d4631e75516def7ab7ff0d8b9310467"
VERSION = REVISION + "+android-sources-4"
SOURCE_SHA256 = "c82e551b82db7066a8f4c0cc83ce6ef58efb14489882fdf5560af6594bc06ce2"
JDK_SHA256 = "c487a1c3a56588b3a32d0d07cdd526bf3d401c4b8422be772ca178bfcd647f3f"
REPOSITORY = Path(__file__).resolve().parent.parent
DEPENDENCIES = REPOSITORY / "target/android-ide/dependencies"
INSTALLATION = DEPENDENCIES / "kotlin-language-server"


def download(name, url, expected):
    archive = DEPENDENCIES / name
    if not archive.exists():
        with tempfile.NamedTemporaryFile(dir=DEPENDENCIES, delete=False) as output:
            temporary = Path(output.name)
            try:
                print(f"Downloading {name}", flush=True)
                with urllib.request.urlopen(url, timeout=60) as response:
                    shutil.copyfileobj(response, output)
                output.flush()
                with temporary.open("rb") as downloaded:
                    if hashlib.file_digest(downloaded, "sha256").hexdigest() != expected:
                        raise RuntimeError(f"Checksum mismatch for {name}")
                temporary.replace(archive)
            finally:
                temporary.unlink(missing_ok=True)
    with archive.open("rb") as source:
        if hashlib.file_digest(source, "sha256").hexdigest() != expected:
            raise RuntimeError(f"Checksum mismatch for {archive}; preserve it and retry with a clean download")
    return archive


def main():
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        raise RuntimeError("This bootstrap currently supports Apple Silicon macOS")
    DEPENDENCIES.mkdir(parents=True, exist_ok=True)
    if INSTALLATION.exists():
        if INSTALLATION.is_symlink() or not (INSTALLATION / ".revision").is_file() or (INSTALLATION / ".revision").read_text().strip() not in (REVISION, REVISION + "+android-sources-1", REVISION + "+android-sources-2", REVISION + "+android-sources-3", VERSION):
            raise RuntimeError(f"Preserving the existing installation at {INSTALLATION}; move it aside first")
        if not (INSTALLATION / "bin/kotlin-language-server").is_file():
            raise RuntimeError("The Kotlin installation is incomplete; move it aside and rerun")
        if (INSTALLATION / ".revision").read_text().strip() == VERSION:
            print(f"Already installed: {INSTALLATION}")
            return
    java_home = os.environ.get("JAVA21_HOME") or subprocess.check_output(
        ["/usr/libexec/java_home", "-v", "21"], text=True
    ).strip()
    java11 = Path(os.environ.get("JAVA11_HOME", DEPENDENCIES / "temurin11/jdk-11.0.32.1+1/Contents/Home"))
    if not (java11 / "bin/java").is_file():
        if "JAVA11_HOME" in os.environ:
            raise RuntimeError("JAVA11_HOME must contain bin/java")
        archive = download(
            "temurin11.tar.gz",
            "https://github.com/adoptium/temurin11-binaries/releases/download/jdk-11.0.32.1%2B1/OpenJDK11U-jdk_aarch64_mac_hotspot_11.0.32.1_1.tar.gz",
            JDK_SHA256,
        )
        with tarfile.open(archive) as source:
            source.extractall(DEPENDENCIES / "temurin11", filter="data")
    archive = download(
        "fwcd-kls-6d9e61b.tar.gz",
        f"https://codeload.github.com/fwcd/kotlin-language-server/tar.gz/{REVISION}",
        SOURCE_SHA256,
    )
    with tempfile.TemporaryDirectory(prefix="kotlin-build-", dir=DEPENDENCIES) as temporary:
        temporary = Path(temporary)
        with tarfile.open(archive) as source:
            source.extractall(temporary, filter="data")
        source = temporary / f"kotlin-language-server-{REVISION}"
        patch = Path(__file__).with_name("android-kotlin-sources.patch").resolve()
        subprocess.run(["patch", "--batch", "-p1", "-i", str(patch)], cwd=source, check=True)
        environment = dict(os.environ, JAVA_HOME=java_home)
        subprocess.run(
            [str(source / "gradlew"), "-p", str(source),
             f"-Porg.gradle.java.installations.paths={java11}",
             ":server:test", "--tests", "org.javacs.kt.Rename*",
             "--tests", "org.javacs.kt.*Definition*", "--tests", "org.javacs.kt.WorkspaceSymbolsTest", "--tests", "org.javacs.kt.externalsources.AttachedSourcesTest",
             ":server:installDist", "--console=plain", "--max-workers=2"],
            env=environment, check=True,
        )
        distribution = source / "server/build/install/server"
        shutil.copy2(source / "LICENSE.txt", distribution / "LICENSE.txt")
        (distribution / ".revision").write_text(VERSION + "\n")
        (distribution / "SOURCE.txt").write_text(f"https://github.com/fwcd/kotlin-language-server/tree/{REVISION}\nPatch: script/android-kotlin-sources.patch\n")
        backup = temporary / "previous-installation"
        if INSTALLATION.exists():
            INSTALLATION.rename(backup)
        try:
            distribution.rename(INSTALLATION)
        except BaseException:
            if backup.exists():
                backup.rename(INSTALLATION)
            raise
    print(f"Installed: {INSTALLATION}")
    print("Relaunch script/android-ide, then run Android: Configure Kotlin in your project.")
    print("Kotlin rename updates Kotlin callers; Java callers still require manual review.")


if __name__ == "__main__":
    main()
